GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

OPENCODE_BINARY=opencode
OPENCODE_DEFAULT_MODEL=
# Task-complexity tiers. Full provider/model IDs only; reasoning effort goes in
# the separate *_VARIANT_* vars (tier names are NEVER valid --model values).
# Discover real IDs with: opencode models
OPENCODE_MODEL_FAST=opencode-go/deepseek-v4.1-flash
OPENCODE_VARIANT_FAST=
OPENCODE_MODEL_CHEAP=opencode-go/deepseek-v4.1-flash
OPENCODE_VARIANT_CHEAP=
OPENCODE_MODEL_STRONG=opencode-go/deepseek-v4.1-flash
OPENCODE_VARIANT_STRONG=high
OPENCODE_MODEL_MAX=opencode-go/deepseek-v4.1-flash
OPENCODE_VARIANT_MAX=xhigh
# Optional JSON policy override, e.g. {"implement": "max"}
MODEL_ROUTER_POLICY=
MODEL_HEALTH_TTL_S=3600
OPENCODE_MIN_VERSION=1.18.0
OPENCODE_TIMEOUT_S=1800

MAX_IMPLEMENTATION_ATTEMPTS=3
MAX_DEBUG_ATTEMPTS=3
MAX_REVIEW_CYCLES=3
MAX_CI_REPAIR_CYCLES=2
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_S=7200
COMMAND_TIMEOUT_S=600
TEST_TIMEOUT_S=900

ENV_DISCOVERY_ENABLED=true
ENV_HARD_GATE=false
USAGE_ENABLED=true

SANDBOX_IMAGE=contributor-sandbox:latest
SANDBOX_CPU=1.0
SANDBOX_MEMORY=2g
SANDBOX_PIDS_LIMIT=256
SANDBOX_NETWORK=bridge
SANDBOX_ALLOW_NETWORK=true
WORKSPACES_ROOT=./.workspaces
SANDBOX_FALLBACK_LOCAL=true
REQUIRE_DOCKER=false

DATABASE_URL=sqlite:///./contributor.db

PR_AI_DISCLOSURE=true
LOG_LEVEL=INFO
LOG_JSON=false
